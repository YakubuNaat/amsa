#!/bin/bash
#SBATCH --job-name={{ job_name }}
#SBATCH --partition={{ partition }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --time={{ walltime }}
#SBATCH --mem={{ memory }}
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

{% for mod in modules -%}
module load {{ mod }}
{% endfor %}

srun {{ qe_exec }} -in {{ input_file }} > {{ output_file }}
